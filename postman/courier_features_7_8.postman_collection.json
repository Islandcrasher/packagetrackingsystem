          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courier",
            "orders",
            "1",
            "status"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"picked_up\"\n}"
        }
      }
    },
